{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name"
		},
		"AzureDatabricks_p6lakehouse": {
			"type": "string"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Master Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Onprem_TO_ADLS_PD",
						"type": "ExecutePipeline",
						"dependsOn": [],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "Full_Load_Pipeline",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true
						}
					},
					{
						"name": "PD_Full",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "Onprem_TO_ADLS_PD",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "Full_Load_Pipeline",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true
						}
					},
					{
						"name": "Gold_Table_Refresh",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "PD_Full",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "[parameters('AzureDatabricks_p6lakehouse')]",
							"type": "LinkedServiceReference",
							"parameters": {
								"databricksurl": "https://adb-1944182279031741.1.azuredatabricks.net",
								"workspaceresourceid": "/subscriptions/2c333fc9-0cd0-4758-a206-313b0728628d/resourceGroups/sc-aftlake-dv-rg/providers/Microsoft.Databricks/workspaces/sc-aftlake-dv-dbx",
								"databrickscluster": "0909-215630-9pyy3n6x"
							}
						}
					}
				],
				"parameters": {
					"service_type": {
						"type": "string",
						"defaultValue": "PD"
					},
					"source_id_val": {
						"type": "string",
						"defaultValue": "31"
					},
					"is_audit": {
						"type": "string",
						"defaultValue": "false"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/Full_Load_Pipeline')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Full_Load_Pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read_Control_Table",
						"type": "DatabricksNotebook",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"baseParameters": {
								"service_type": "@pipeline().parameters.service_type",
								"load_type": "full"
							}
						}
					},
					{
						"name": "ForEach_Switch",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Read_Control_Table",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"typeProperties": {
							"items": {
								"value": "@activity('Read_control_tbl').output.runOutput",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "perform_full_load_p6",
									"type": "DatabricksNotebook",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "[parameters('AzureDatabricks_p6lakehouse')]",
										"type": "LinkedServiceReference",
										"parameters": {
											"databricksurl": "https://adb-1944182279031741.1.azuredatabricks.net",
											"workspaceresourceid": "/subscriptions/2c333fc9-0cd0-4758-a206-313b0728628d/resourceGroups/sc-aftlake-dv-rg/providers/Microsoft.Databricks/workspaces/sc-aftlake-dv-dbx",
											"databrickscluster": "0909-215630-9pyy3n6x"
										}
									}
								},
								{
									"name": "update_logtable",
									"type": "DatabricksNotebook",
									"dependsOn": [
										{
											"activity": "perform_full_load_p6",
											"dependencyConditions": [
												"Completed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "[parameters('AzureDatabricks_p6lakehouse')]",
										"type": "LinkedServiceReference",
										"parameters": {
											"databricksurl": "https://adb-1944182279031741.1.azuredatabricks.net",
											"workspaceresourceid": "/subscriptions/2c333fc9-0cd0-4758-a206-313b0728628d/resourceGroups/sc-aftlake-dv-rg/providers/Microsoft.Databricks/workspaces/sc-aftlake-dv-dbx",
											"databrickscluster": "0909-215630-9pyy3n6x"
										}
									}
								}
							]
						}
					},
					{
						"name": "perform_fullload_p6",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "ForEach_Switch",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": []
					},
					{
						"name": "update_logtable",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "perform_fullload_p6",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": []
					},
					{
						"name": "Run Pipeline",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "update_logtable",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "P6_Recon",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true
						}
					}
				],
				"parameters": {
					"service_type": {
						"type": "string",
						"defaultValue": "PD"
					},
					"is_incremental": {
						"type": "string",
						"defaultValue": "false"
					},
					"is_audit": {
						"type": "string",
						"defaultValue": "false"
					},
					"source_id_val": {
						"type": "string",
						"defaultValue": "31"
					}
				},
				"variables": {
					"SourceRowCount": {
						"type": "Integer"
					},
					"TargetRowCount": {
						"type": "Integer"
					},
					"LoadStatus": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/P6_Recon')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/P6_Recon')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "read_audit_table",
						"type": "DatabricksNotebook",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"baseParameters": {
								"service_type": "pd",
								"load_type": "incremental"
							}
						},
						"linkedServiceName": {
							"referenceName": "[parameters('AzureDatabricks_p6lakehouse')]",
							"type": "LinkedServiceReference",
							"parameters": {
								"databricksurl": "https://adb-1944182279031741.1.azuredatabricks.net",
								"workspaceresourceid": "/subscriptions/2c333fc9-0cd0-4758-a206-313b0728628d/resourceGroups/sc-aftlake-dv-rg/providers/Microsoft.Databricks/workspaces/sc-aftlake-dv-dbx",
								"databrickscluster": "0909-215630-9pyy3n6x"
							}
						}
					},
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "read_audit_table",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('read_audit_table').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "json_converter",
									"type": "SetVariable",
									"dependsOn": [],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "CurrentTable",
										"value": "@item().table_name"
									}
								}
							]
						}
					}
				],
				"variables": {
					"CurrentTable": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		}
	]
}